      "isCommentAutoGenerated": true
    },
    "30": {
      "comment": "A value for the minimum tempo on the \"Tempo\" slider.",
      "isCommentAutoGenerated": true
    },
    "A note an octave above the one you played is sent back when the hit lands in the “right” zone. Leave Local Control on, so you keep hearing your own notes alongside it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note située une octave au-dessus de celle que tu joues est renvoyée au clavier quand la frappe tombe dans la zone « juste ». Laisse le Local Control activé, pour continuer à entendre tes propres notes à côté."
          }
        }
      }
    },
    "Acoustic guitar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guitare acoustique"
          }
        }
