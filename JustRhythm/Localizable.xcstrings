        }
      }
    },
    "Started on the keyboard's Start message, but no MIDI clock is arriving. The tempo stays the one set here and will drift apart from your drum machine — enable clock transmission on the instrument.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Départ pris sur le message Start du clavier, mais aucune horloge MIDI n'arrive. Le tempo reste celui réglé ici et va dériver de ta boîte à rythmes — active la transmission de l'horloge sur l'instrument."
          }
        }
      },
      "extractionState": "stale"
    },
    "Statistics window": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
