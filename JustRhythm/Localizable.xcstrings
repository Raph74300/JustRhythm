    "Bluetooth adds 10 to 20 ms of variable delay. Your average will be skewed — your regularity stays accurate. Prefer USB.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bluetooth ajoute 10 à 20 ms de retard variable. Ta moyenne en sera faussée — ta régularité, elle, reste juste. Préfère l'USB."
          }
        }
      }
    },
