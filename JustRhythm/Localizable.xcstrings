{
  "sourceLanguage": "en",
  "strings": {
    " The click only sounds on the beat, never on subdivisions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Le clic ne sonne que sur les temps, jamais sur les subdivisions."
          }
        }
      }
    },
