    "Audio output delayed by %d ms — likely a wireless output, which will skew the average." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortie audio en retard de %d ms — sortie sans fil probable, la moyenne sera faussée."
          }
        }
      }
    },
    "Audio unavailable: %@" : {
      "localizations" : {
        "fr" : {
